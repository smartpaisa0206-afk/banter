<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ink"
    android:paddingTop="4dp">

    <com.banter.keyboard.BanterCandidateView
        android:id="@+id/candidates"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#10101a" />

    <LinearLayout
        android:id="@+id/toolbar_row"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="#0f0f18"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tool_extra"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tool_settings"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#d8d8e6"
            android:textSize="22sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tool_magic"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🪄"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ink"
        android:keyBackground="@drawable/keyboard_key_bg"
        android:keyTextColor="#ffffff"
        android:keyTextSize="18sp"
        android:keyPreviewLayout="@null"
        android:padding="4dp" />
</LinearLayout>
