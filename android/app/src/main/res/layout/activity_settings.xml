<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Banter Keyboard"
            android:textColor="@color/brand"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login once, then tap the Banter key inside any app to rewrite what you typed."
            android:textColor="#8b8ba7"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy note: Banter only sends your current text to the server when you tap the Banter key."
            android:textColor="#ffffff"
            android:background="#151526"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://banter-mu.vercel.app"
            android:inputType="textUri"
            android:textColor="#ffffff"
            android:textColorHint="#8b8ba7" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Banter email"
            android:inputType="textEmailAddress"
            android:textColor="#ffffff"
            android:textColorHint="#8b8ba7"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Banter password used once, not stored"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#8b8ba7"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick modes"
            android:textColor="#8b8ba7"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_personal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Personal" />

            <Button
                android:id="@+id/btn_professional"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Professional"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_genz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gen-Z" />

            <Button
                android:id="@+id/btn_roast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Roast"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Defaults used when you tap the Banter key"
            android:textColor="#8b8ba7"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_relationship"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="relationship: partner, crush, friend, boss, client"
            android:textColor="#ffffff"
            android:textColorHint="#8b8ba7"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_intent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="intent: flirt, icebreaker, apologize, email_professional"
            android:textColor="#ffffff"
            android:textColorHint="#8b8ba7"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_tone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="tone: warm, confident, formal"
            android:textColor="#ffffff"
            android:textColorHint="#8b8ba7"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="language code: en, hi"
            android:textColor="#ffffff"
            android:textColorHint="#8b8ba7"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/cb_hurry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hurry mode: one short reply"
            android:textColor="#ffffff"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save and Connect"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="After saving: Android Settings → Keyboard → Manage keyboards → enable Banter Keyboard. Then select it in any text field."
            android:textColor="#8b8ba7"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
